# PostgreSQL — WhatsApp CRM schema (whatsapp-bridge/sql), NOT the .NET `clinicsaas` DB unless you merged schemas.
# Local: if port 5435 already hosts .NET `clinicsaas`, create `clinic_ops` and point here:
#   npm run db:provision-local-ops
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/clinic_ops

# Random secret, min 16 chars
JWT_SECRET=change-me-to-a-long-random-string

# Server-side bridge (must match whatsapp-bridge BRIDGE_SEND_API_TOKEN if set)
BRIDGE_INTERNAL_URL=http://127.0.0.1:3100
BRIDGE_SEND_TOKEN=

# n8n / automation calls these routes with Bearer token (must match n8n SCHEDULING_SERVICE_TOKEN)
SCHEDULING_SERVICE_TOKEN=

# Optional: multi-clinic WhatsApp routing (comma-separated clinic ids) for process-inbound booking flow
# WHATSAPP_ROUTING_CLINIC_IDS=1,2,3

# Reply window (patient): proactive rows are enqueued only if last inbound is inside the window at
# enqueue time; outbox-drain HARD-DROPs (blocked) if policy fails. Kill switch blocks patient paths only.
# PATIENT_REPLY_WINDOW_MS=900000
# PATIENT_REPLY_WINDOW_MINUTES=15
# WHATSAPP_KILL_SWITCH=false

# Optional event bus (Redis Streams publisher from process-inbound)
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_EVENTS_STREAM=ops:events:inbound

# Demo: banner (NEXT_PUBLIC_) + block destructive "doctor left" reschedule on server
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Optional: cap pg pool size (default 10, max 50)
# PG_POOL_MAX=10

# Optional: Ollama for /api/internal/scheduling/interpret (Arabic NLP). If unset, heuristics only.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
