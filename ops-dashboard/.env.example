# PostgreSQL — WhatsApp CRM schema (whatsapp-bridge/sql), NOT the .NET `clinicsaas` DB unless you merged schemas.
# Local: if port 5435 already hosts .NET `clinicsaas`, create `clinic_ops` and point here:
#   npm run db:provision-local-ops
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/clinic_ops

# Random secret, min 16 chars
JWT_SECRET=change-me-to-a-long-random-string

# Server-side bridge (must match whatsapp-bridge BRIDGE_SEND_API_TOKEN if set)
BRIDGE_INTERNAL_URL=http://127.0.0.1:3100
# Optional second probe URL (set host gateway for your compose network, not necessarily 172.17.0.1)
# BRIDGE_INTERNAL_FALLBACK_URL=http://172.18.0.1:3100
BRIDGE_SEND_TOKEN=
# ms — POST /send from ops to bridge (default 5000)
# BRIDGE_SEND_TIMEOUT_MS=5000
# ms — probe timeout for GET /ready from ops to bridge (host.docker.internal can be slow first hit)
# BRIDGE_HEALTH_TIMEOUT_MS=12000

# n8n / automation calls these routes with Bearer token (must match n8n SCHEDULING_SERVICE_TOKEN)
SCHEDULING_SERVICE_TOKEN=
# Production: use high-entropy token >=24 chars; weak defaults are rejected.

# Optional: comma-separated reviewed_by values allowed for AI calibration samples (empty = no extra filter)
# CALIBRATION_TRUSTED_REVIEWERS=ops_staff,ops@local.test

# Dev-only: if set, allows super_admin to login by providing otp_code == this value.
# DO NOT use in production.
# SUPERADMIN_DEV_OTP=026114

# Optional: multi-clinic WhatsApp routing (comma-separated clinic ids) for process-inbound booking flow
# WHATSAPP_ROUTING_CLINIC_IDS=1,2,3

# Freeze source-of-truth flag used by runbooks and legacy .NET gate.
OPS_WHATSAPP_PRIMARY_HANDLER=ops

# Reply window (patient): proactive rows are enqueued only if last inbound is inside the window at
# enqueue time; outbox-drain HARD-DROPs (blocked) if policy fails. Kill switch blocks patient paths only.
# PATIENT_REPLY_WINDOW_MS=900000
# PATIENT_REPLY_WINDOW_MINUTES=15
# WHATSAPP_KILL_SWITCH=false

# Optional event bus (Redis Streams publisher from process-inbound)
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_EVENTS_STREAM=ops:events:inbound

# Demo: banner (NEXT_PUBLIC_) + block destructive "doctor left" reschedule on server
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Optional: cap pg pool size (default 10, max 50)
# PG_POOL_MAX=10

# Optional: external AI analyze endpoint (POST /analyze). If unset, HeuristicAdapter is used in-process.
# EXTERNAL_AI_URL=https://your-model-endpoint
# EXTERNAL_AI_TOKEN=
# AI_CONFIDENCE_THRESHOLD=0.72

# Optional: Ollama for interpretInboundText + /api/internal/scheduling/interpret (Arabic NLP). If unset, heuristics only.
# On VPS: run `ollama pull qwen2.5:7b` then set URL to http://127.0.0.1:11434 (see docs/OLLAMA_VPS.md).
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b

# Decision layer (processInbound): when "1", records routing.last_decision + metrics; does not send WhatsApp by itself.
# INBOUND_DECISION_ENGINE=0
# Reserved for future auto-book outside emergency/dialogue paths (currently increments skipped counter only).
# INBOUND_AUTO_BOOK=0
# Emergency kill switch: when "1", disables emergency auto-allocation and forces handoff.
# EMERGENCY_GLOBAL_DISABLE=0

# Optional: for trial onboarding credential email via webhook (n8n/mailer).
# TRIAL_WELCOME_EMAIL_WEBHOOK_URL=
# Optional: password reset email webhook (receives { email, reset_link, kind }).
# AUTH_RESET_EMAIL_WEBHOOK_URL=
# Optional: HMAC secret for billing webhook signature verification.
# BILLING_WEBHOOK_SECRET=
# Optional: public ops URL used in trial direct access links.
# OPS_PUBLIC_URL=http://127.0.0.1:3001

# P4 hybrid observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=ops-dashboard
# OTEL_DEPLOYMENT_ENV=local
# SENTRY_DSN=

# --- P7 WhatsApp safety (Balanced defaults; all optional) ---
# WA_SAFETY_WINDOW_MS=60000
# WA_SAFETY_CLINIC_MAX_PER_WINDOW=45
# WA_SAFETY_GLOBAL_PATIENT_MAX=120
# WA_SAFETY_GLOBAL_STAFF_MAX=300
# WA_SAFETY_JITTER_MS_MIN=120
# WA_SAFETY_JITTER_MS_MAX=780
# WA_SAFETY_MAX_WAIT_MS=12000
# WA_SAFETY_CIRCUIT_WINDOW_MS=180000
# WA_SAFETY_CIRCUIT_FAILURE_THRESHOLD=10
# P7 outbound guard (patient text)
# P7_OUTBOUND_MAX_CHARS=3500
