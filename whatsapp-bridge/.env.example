# Copy to `.env` on the bridge host. Do not commit real secrets.
#
# VPS (Ubuntu 24 + n8n on same host): use 127.0.0.1 for webhooks and ops.
# Match `SCHEDULING_SERVICE_TOKEN` / `N8N_WEBHOOK_HMAC_SECRET` / `BRIDGE_SEND_API_TOKEN`
# with `ops-dashboard` + n8n env (e.g. `.env.prod`).
#
# Chromium on Ubuntu 24 often resolves to snap: `which chromium` -> /snap/bin/chromium
# If Puppeteer fails to launch, try the real binary under /snap/chromium/current/usr/lib/chromium-browser/chrome

# --- Bridge / WhatsApp ---
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/whatsapp
# Optional HMAC on webhook JSON body: header X-Bridge-Signature: sha256=<hex>
N8N_WEBHOOK_HMAC_SECRET=
BRIDGE_PORT=3100
CLINIC_ID=1
# Same-host ops-dashboard (bridge runs on VPS, not inside Docker)
OPS_DASHBOARD_URL=http://127.0.0.1:3001
# Bearer token for /api/internal/scheduling/* from bridge (same as SCHEDULING_SERVICE_TOKEN in ops)
SCHEDULING_SERVICE_TOKEN=
WA_AUTH_DIR=auth-webjs
# true = headless server (typical VPS). false = local dev with display / QR in terminal
WA_HEADLESS=true
# Ubuntu snap: /snap/bin/chromium — Windows: path to chrome.exe
WA_CHROME_PATH=/snap/bin/chromium
WA_AUTH_TIMEOUT_MS=900000
WA_ALLOW_GROUPS=false
# If true, bridge shows clinic selection menus (DEV only). Default false to keep ops-dashboard as single reply source.
WA_ROUTING_MENUS=false
WA_ALERT_URGENT_TO=
# If set, POST /send requires: Authorization: Bearer <token>
BRIDGE_SEND_API_TOKEN=
REPLY_WINDOW_HOURS=24
REPLY_MIN_DELAY_MS=1200
REPLY_MAX_DELAY_MS=3200
INBOUND_DEDUP_WINDOW_MS=45000
MAX_REPLIES_PER_HOUR_PER_CHAT=40
MAX_SENDS_PER_MINUTE_PER_CHAT=12
NIGHT_MUTE_START_HOUR=
NIGHT_MUTE_END_HOUR=
WA_RECONNECT_INITIAL_MS=5000
WA_RECONNECT_MAX_MS=300000
WA_TYPING_INDICATOR_MS=0
BRIDGE_EVENT_LOG_FILE=logs/bridge-events.ndjson

# --- Enterprise outbound / stability ---
OUTBOUND_QUEUE_FILE=logs/outbound-queue.ndjson
# Failed n8n webhook POSTs (same raw JSON + HMAC on retry)
INBOUND_WEBHOOK_QUEUE_FILE=logs/inbound-webhook-queue.ndjson
INBOUND_WEBHOOK_FLUSH_INTERVAL_MS=30000
INBOUND_WEBHOOK_MAX_ATTEMPTS=50
INBOUND_WEBHOOK_MAX_AGE_MS=86400000
SEND_MAX_RETRIES=3
SEND_RETRY_BASE_MS=800
SEND_ACK_TIMEOUT_MS=120000
WA_CB_WINDOW_MS=600000
WA_CB_DISCONNECT_THRESHOLD=5
WA_CB_COOLDOWN_MS=300000
# If true, deletes .wwebjs_cache on circuit open (not the auth folder)
WA_REPAIR_CACHE_ON_CIRCUIT=false
MEMORY_WATCHDOG_INTERVAL_MS=60000
MEMORY_HEAP_RATIO_WARN=0.88
GRACEFUL_SHUTDOWN_MS=25000

# --- PostgreSQL CRM (optional inside bridge for future features) ---
CRM_DB_HOST=127.0.0.1
# 5435 = docker-compose.clinic.yml default; production compose often publishes 5432
CRM_DB_PORT=5435
CRM_DB_NAME=clinicsaas
CRM_DB_USER=postgres
CRM_DB_PASSWORD=
CRM_DB_SSL=false

# --- AI (OpenAI-compatible or use self-hosted via n8n + Ollama) ---
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_MODEL=gpt-4o-mini
AI_ALLOW_REPLY_DRAFTS=true
AI_MAX_REPLY_CHARS=280
AI_TIMEOUT_MS=30000
AI_FAIL_OPEN_TO_RULES=true
AI_REQUIRE_JSON=true
AI_SYSTEM_LANGUAGE=ar
AI_CIRCUIT_BREAKER_WINDOW_MS=60000
AI_CIRCUIT_BREAKER_MAX_FAILURES=5
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
