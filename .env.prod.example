# انسخ إلى `.env.prod` في جذر المستودع (لا ترفع الملف إلى Git).
# الاستخدام:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# إن احتوت كلمة مرور Postgres على / أو + أو @ أو : فاستخدم ترميز URL داخل DATABASE_URL
# (مثال: / → %2F ، + → %2B).

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=clinicsaas
# اختياري لأدوات على المضيف (psql من خارج Docker). حاويات ops-dashboard وevent-consumer
# تبني الاتصال من POSTGRES_* داخل docker-compose.prod.yml بمضيف postgres تلقائيًا.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/clinicsaas

# --- ops-dashboard ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SCHEDULING_SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# ⚠️ غير موصى به: تعطيل حجب IP لحساب السوبر أدمن (استخدمه مؤقتًا فقط أثناء الإعداد)
# SUPERADMIN_IP_ALLOWLIST_DISABLED=1

# --- n8n (إلزامي في compose الإنتاجي) ---
N8N_BASIC_AUTH_USER=clinicadmin
N8N_BASIC_AUTH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# بدون نطاق n8n بعد: http://127.0.0.1:5678/ — مع DNS لـ n8n: https://n8n.tenegta.tech/
N8N_PUBLIC_WEBHOOK_URL=http://127.0.0.1:5678/

# داخل Docker: n8n يتصل بـ ops-dashboard بالاسم الخدمي
OPS_DASHBOARD_URL=http://ops-dashboard:3001

# اختياري — جسر واتساب على المضيف
# BRIDGE_INTERNAL_URL=http://host.docker.internal:3100

# --- منافذ على المضيف (127.0.0.1 فقط — Nginx يعمل كوكيل) ---
# WEB_PUBLISH_PORT=3000
# OPS_PUBLISH_PORT=3001
# N8N_PUBLISH_PORT=5678
