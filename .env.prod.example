# انسخ إلى `.env.prod` في جذر المستودع (لا ترفع الملف إلى Git).
# الاستخدام:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# إن احتوت كلمة مرور Postgres على / أو + أو @ أو : فاستخدم ترميز URL داخل DATABASE_URL
# (مثال: / → %2F ، + → %2B).

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=clinic_ops
# اختياري لأدوات على المضيف (psql من خارج Docker). حاويات ops-dashboard وevent-consumer
# تبني الاتصال من POSTGRES_* داخل docker-compose.prod.yml بمضيف postgres تلقائيًا.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/clinic_ops

# --- ops-dashboard + clinic-web (نفس القيمة في الخدمتين) ---
# استخدم openssl rand -hex 32 أو ما يعادله — 32+ حرفًا عشوائيًا لكل سر
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
# رمز خدمة داخلي — clinic-web يُرسله كـ Bearer إلى ops-dashboard؛ إن اختلف عن ops يظهر 401 على لوحة /platform
SCHEDULING_SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN_MIN_32_CHARS
# ملكية وارد واتساب: ops فقط (.NET يرجع 409 عند ops)
OPS_WHATSAPP_PRIMARY_HANDLER=ops
# محظور في الإنتاج — لا تفعّل أبدًا (يتجاوز IP allowlist لـ super_admin)
# SUPERADMIN_IP_ALLOWLIST_DISABLED=1

# --- n8n (إلزامي في compose الإنتاجي) ---
N8N_BASIC_AUTH_USER=clinicadmin
N8N_BASIC_AUTH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# بدون نطاق n8n بعد: http://127.0.0.1:5678/ — مع DNS لـ n8n: https://n8n.tenegta.tech/
N8N_PUBLIC_WEBHOOK_URL=http://127.0.0.1:5678/

# داخل Docker: n8n يتصل بـ ops-dashboard بالاسم الخدمي
OPS_DASHBOARD_URL=http://ops-dashboard:3001

# --- Redis (اتركه فارغًا إذا لا توجد خدمة redis في compose — REDIS_URL= يعطّل locks/deferred) ---
REDIS_URL=

# --- جسر واتساب (على المضيف — لا تفتح 3100 على WAN؛ انظر deploy/BRIDGE_NETWORK_SECURITY.md) ---
# نفس القيمة في whatsapp-bridge/.env كـ BRIDGE_SEND_API_TOKEN
BRIDGE_SEND_TOKEN=REPLACE_WITH_RANDOM_TOKEN_MIN_32_CHARS
# من داخل ops-dashboard استخدم IPv4 لبوابة شبكة compose (ليس host.docker.internal — قد يحلّ إلى IPv6).
# Gateway: docker network inspect clinic-os_default --format '{{(index .IPAM.Config 0).Gateway}}'
BRIDGE_INTERNAL_URL=http://172.16.1.1:3100
# إن فشل فحص الجسر: على المضيف يجب أن يستمع الجسر على 0.0.0.0 (BRIDGE_BIND_HOST في whatsapp-bridge/.env). ثانويًا جرّب بوابة شبكة compose وليس docker0 فقط:
# docker compose ... config --format json | jq ...  أو: docker network inspect <name>_default | grep Gateway
# BRIDGE_INTERNAL_FALLBACK_URL=http://172.18.0.1:3100
# مهلة فحص الجسر من ops-dashboard (افتراضي 12000ms داخل الكود إن لم تُضبط)
# BRIDGE_HEALTH_TIMEOUT_MS=12000

# --- Ollama (النهج المختلط — على المضيف، ليس للإنترنت العام) ---
# scripts/vps-install-ollama-qwen.sh على VPS ثم:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# INBOUND_INTERPRET_FAST_PATH=false
# Docker على Linux: استخدم gateway الشبكة بدل 127.0.0.1 إن لزم (راجع docs/OLLAMA_VPS.md)

# --- منافذ على المضيف (127.0.0.1 فقط — Nginx يعمل كوكيل) ---
# WEB_PUBLISH_PORT=3000
# OPS_PUBLISH_PORT=3001
# N8N_PUBLISH_PORT=5678

# --- نموذج التواصل (clinic-web → info@tenegta.com) ---
CONTACT_TO_EMAIL=info@tenegta.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tenegta.com
SMTP_PASS=REPLACE_WITH_MAILBOX_PASSWORD
# SMTP_FROM="نسق <info@tenegta.com>"
# CONTACT_EMAIL_WEBHOOK_URL=

# --- ops-dashboard external AI (optional) ---
# EXTERNAL_AI_URL=https://your-model-endpoint
# EXTERNAL_AI_TOKEN=
# AI_CONFIDENCE_THRESHOLD=0.72
