# Nginx على المضيف — وكيل إلى حاويات Docker (منفذ محلي فقط).
# بعد التثبيت:
#   sudo cp deploy/nginx/tenegta.tech.conf.example /etc/nginx/sites-available/tenegta.tech
#   sudo ln -sf /etc/nginx/sites-available/tenegta.tech /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d tenegta.tech -d www.tenegta.tech
# DNS: سجل A للاسم ops → نفس IP السيرفر، ثم:
#   sudo certbot --nginx -d ops.tenegta.tech
#
# إذا كان الملف على السيرفر معدّلاً مسبقاً بـ Certbot، انسخ كتلة server الخاصة بـ ops فقط
# أو دمج يدوي بدل استبدال الملف بالكامل.
# خلف Cloudflare: أضف proxy_set_header CF-Connecting-IP (كما أدناه) أو:
#   include /etc/nginx/snippets/proxy-to-nextjs-cloudflare.conf;
#   انظر: deploy/nginx/snippets/proxy-to-nextjs-cloudflare.conf

upstream clinic_web {
  server 127.0.0.1:3000;
}

upstream clinic_ops {
  server 127.0.0.1:3001;
}

# الواجهة العامة (Next.js apps/web)
server {
  listen 80;
  listen [::]:80;
  server_name tenegta.tech www.tenegta.tech;

  location / {
    include /etc/nginx/snippets/proxy-to-nextjs-cloudflare.conf;
    proxy_pass http://clinic_web;
  }
}

# لوحة العمليات (ops-dashboard على 3001) — سجل A: ops → IP السيرفر
server {
  listen 80;
  listen [::]:80;
  server_name ops.tenegta.tech;

  location / {
    include /etc/nginx/snippets/proxy-to-nextjs-cloudflare.conf;
    proxy_pass http://clinic_ops;
  }
}
