# استبدال ملف nginx على VPS بعد النسخ الاحتياطي:
#   sudo cp /etc/nginx/sites-available/tenegta.tech /etc/nginx/sites-available/tenegta.tech.bak.manual
# ارفع هذا الملف إلى:
#   /etc/nginx/sites-available/tenegta.tech
# ثم:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d ops.tenegta.tech
#
# يفترض وجود شهادة Let's Encrypt للموقع الرئيسي تحت:
#   /etc/letsencrypt/live/tenegta.tech/

upstream clinic_web {
  server 127.0.0.1:3000;
}

upstream clinic_ops {
  server 127.0.0.1:3001;
}

# الموقع العام — clinic-web (مع HTTPS إن وُجدت الشهادة أعلاه)
server {
  listen 80;
  listen [::]:80;
  listen 443 ssl;
  listen [::]:443 ssl ipv6only=on;
  server_name tenegta.tech www.tenegta.tech;

  ssl_certificate /etc/letsencrypt/live/tenegta.tech/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/tenegta.tech/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  location / {
    proxy_pass http://clinic_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# لوحة العمليات — ops-dashboard (HTTP أولاً؛ Certbot يضيف 443 لـ ops بعد الأمر أدناه)
server {
  listen 80;
  listen [::]:80;
  server_name ops.tenegta.tech;

  location / {
    proxy_pass http://clinic_ops;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
