# نسخة للمرجع فقط — انسخ إلى `.env` في نفس المجلد (الجذر) وعدّل القيم.
#   PowerShell: Copy-Item .env.example .env
# ملف `.env` مستبعد من Git (انظر `.gitignore`).
#
# يستخدمه: docker compose -f docker-compose.clinic.yml
# Docker Compose يقرأ `.env` تلقائياً من مجلد العمل الحالي.

# --- PostgreSQL (alias على المضيف: 127.0.0.1:5435 → 5432 داخل الحاوية) ---
# يجب أن يطابق USER:PASS في DATABASE_URL لأدوات مثل ops-dashboard إن استخدمت نفس المثبت.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET

# --- واجهة n8n (Basic Auth) ---
N8N_BASIC_AUTH_USER=clinicadmin
N8N_BASIC_AUTH_PASSWORD=REPLACE_WITH_STRONG_SECRET

# اختياري — عبّأها إن شغّلت n8n أو الوظائف التي تعتمد عليها
# SCHEDULING_SERVICE_TOKEN=
# N8N_WEBHOOK_HMAC_SECRET=
# BRIDGE_SEND_API_TOKEN=
