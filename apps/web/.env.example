# Base URL of ops-dashboard (same machine: http://127.0.0.1:3001)
OPS_DASHBOARD_URL=http://127.0.0.1:3001

# Must match ops-dashboard SCHEDULING_SERVICE_TOKEN (server-side only; never NEXT_PUBLIC_)
SCHEDULING_SERVICE_TOKEN=

# Internal-only clinical QA panel for medical signal correction in Inbox Decision Card.
NEXT_PUBLIC_SHOW_MEDICAL_QA_PANEL=0

# Launch freeze: ops-dashboard is the production source of truth for inbound/trial flows.
# .NET endpoints are legacy-only and must not be used as parallel inbound path.
# DOTNET_API_URL=http://127.0.0.1:5080

# P4 hybrid observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=apps-web
# OTEL_DEPLOYMENT_ENV=local
# NEXT_PUBLIC_SENTRY_DSN=
