ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:5137

Postgres__ConnectionString=Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<password>

Jwt__SigningKey=<very_long_random_secret>
Jwt__Issuer=ClinicSaaS
Jwt__Audience=ClinicSaaS
Jwt__AccessTokenMinutes=30

N8n__BaseUrl=<https://n8n.example.com>
N8n__ApiKey=<n8n_api_key>
N8n__TimeoutSeconds=20
N8n__Paths__AppointmentCreatedPath=/webhooks/appointment-created
N8n__Paths__AppointmentUpdatedPath=/webhooks/appointment-updated
N8n__Paths__DoctorDelayedPath=/webhooks/doctor-delayed

# Ops-first freeze (72h launch)
OPS_WHATSAPP_PRIMARY_HANDLER=ops
SCHEDULING_SERVICE_TOKEN=<random_32_plus_chars>
JWT_SECRET=<random_32_plus_chars>
N8N_BASIC_AUTH_USER=<n8n_admin_user>
N8N_BASIC_AUTH_PASSWORD=<n8n_strong_password>
# Ops emergency kill switch (ops-dashboard): set to 1 for immediate emergency auto-flow stop.
EMERGENCY_GLOBAL_DISABLE=0
