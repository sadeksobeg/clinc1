{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "ConnectionString": "${POSTGRES_CONNECTION_STRING}"
  },
  "Jwt": {
    "Issuer": "ClinicSaaS",
    "Audience": "ClinicSaaS",
    "SigningKey": "${JWT_SIGNING_KEY}",
    "AccessTokenMinutes": 30
  },
  "Tenancy": {
    "TenantHeader": "X-Tenant-Id",
    "SubdomainSeparator": "."
  },
  "N8n": {
    "BaseUrl": "${N8N_BASE_URL}",
    "ApiKey": "${N8N_API_KEY}",
    "TimeoutSeconds": 20,
    "Paths": {
      "AppointmentCreatedPath": "/webhooks/appointment-created",
      "AppointmentUpdatedPath": "/webhooks/appointment-updated",
      "DoctorDelayedPath": "/webhooks/doctor-delayed"
    }
  }
}
